rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Global synced theme settings (theme.json properties)
    match /themes/{themeId} {
      allow read, write: if isSignedIn();
    }

    // Compressed custom theme logos (header-logo.png & center-logo.png data)
    match /theme_assets/{themeId} {
      allow read, write: if isSignedIn();
    }

    // Isolated per-device live kiosk session crash-recovery backups
    match /kiosk_backups/{deviceId} {
      allow read, write: if isSignedIn();
    }

    // Reusable named wheel setups (segments, quantities, baseline)
    match /wheel_instances/{instanceId} {
      allow read, write: if isSignedIn();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
